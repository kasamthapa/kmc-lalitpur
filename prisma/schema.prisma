// prisma/schema.prisma — Prisma 7
//
// Prisma 7 breaking change: url/directUrl are no longer valid here.
// Connection URLs are managed in prisma.config.ts (migrations) and
// the PrismaClient adapter (runtime). See app/lib/prisma.ts.

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── News & Events ────────────────────────────────────────────────────────────

model News {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title           String
  slug            String   @unique
  description     String?
  content         String?
  category        String?
  imageUrl        String?  @map("image_url")
  published       Boolean  @default(false)
  featured        Boolean  @default(false)
  metaTitle       String?  @map("meta_title")
  metaDescription String?  @map("meta_description")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("news")
}

// ─── Gallery ──────────────────────────────────────────────────────────────────
// Stores metadata only — actual images live on Cloudinary.
// src is the Cloudinary secure URL of the image.

model Gallery {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  src          String
  alt          String
  category     String?
  caption      String?
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("gallery")
}

// ─── Contact Enquiries ────────────────────────────────────────────────────────

model Enquiry {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  email     String
  phone     String?
  subject   String?
  stream    String?
  message   String
  read      Boolean  @default(false)
  responded Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("enquiries")
}

// ─── Scrolling Notice Board ───────────────────────────────────────────────────

model Notice {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  text         String
  active       Boolean   @default(true)
  displayOrder Int       @default(0) @map("display_order")
  startDate    DateTime? @map("start_date") @db.Date
  endDate      DateTime? @map("end_date") @db.Date
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("notices")
}

// ─── Blog ─────────────────────────────────────────────────────────────────────

model BlogPost {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title           String
  slug            String   @unique
  excerpt         String?
  content         String?
  category        String?
  imageUrl        String?  @map("image_url")
  author          String?
  readTime        String?  @map("read_time")
  published       Boolean  @default(false)
  featured        Boolean  @default(false)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("blog_posts")
}

// ─── Admin Users ──────────────────────────────────────────────────────────────

model AdminUser {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique
  name         String?
  passwordHash String   @map("password_hash")
  role         String   @default("editor")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("admin_users")
}

// ─── Faculty & Staff ──────────────────────────────────────────────────────────

model Faculty {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  slug         String   @unique
  title        String   // e.g. "Head of Science Department"
  dept         String   // Science | Management | Law | Administration
  qualification String
  experience   String   // e.g. "12 years"
  subjects     String?  // comma-separated
  email        String?
  bio          String?  // paragraph shown on detail page
  achievements String?  // newline-separated list of achievements
  imageUrl     String?  @map("image_url")
  active       Boolean  @default(true)
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("faculty")
}

// ─── Alumni ───────────────────────────────────────────────────────────────────

model Alumni {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  gradYear    String   @map("grad_year")       // e.g. "2078 B.S."
  program     String                            // Science | Management | Law
  currentRole String?  @map("current_role")    // e.g. "Software Engineer"
  company     String?                           // e.g. "Ncell"
  location    String?                           // e.g. "Kathmandu"
  email       String?
  phone       String?
  bio         String?
  imageUrl    String?  @map("image_url")
  linkedIn    String?  @map("linked_in")
  approved    Boolean  @default(false)          // admin must approve before shown publicly
  featured    Boolean  @default(false)          // show in featured section
  displayOrder Int     @default(0) @map("display_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("alumni")
}

// NOTE: No Question or MockResult models.
// Mock tests are handled via Microsoft Forms — no custom exam engine in the DB.

// ─── Entrance Exam Applications ───────────────────────────────────────────────

model EntranceApplication {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  referenceNo          String   @unique @map("reference_no")   // e.g. KMC-2083-A1B2C

  // Personal Details
  fullName             String   @map("full_name")
  dateOfBirth          String   @map("date_of_birth")          // "YYYY-MM-DD"
  gender               String                                   // Male | Female | Other
  phone                String
  email                String?
  address              String

  // Academic Details
  stream               String                                   // Science | Management | Law
  seeSchool            String   @map("see_school")
  seeYear              String   @map("see_year")               // e.g. "2081"
  seeGpa               String   @map("see_gpa")                // e.g. "3.85"
  seeMaths             String?  @map("see_maths")              // grade letter e.g. "A+"
  seeScience           String?  @map("see_science")
  seeEnglish           String?  @map("see_english")

  // Payment Proof
  paymentScreenshotUrl String   @map("payment_screenshot_url")

  // Admin Management
  status               String   @default("pending")            // pending | verified | rejected
  adminNote            String?  @map("admin_note")
  verifiedAt           DateTime? @map("verified_at")

  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@index([stream])
  @@index([status])
  @@index([createdAt])
  @@index([phone])
  @@index([referenceNo])
  @@map("entrance_applications")
}

model Popup {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String?                                  // headline text
  body         String?                                  // paragraph / description
  imageUrl     String?  @map("image_url")              // optional banner image
  imageFit     String   @default("natural") @map("image_fit") // natural | cover
  buttons      String?                                  // JSON: [{label,url,style}]
  active       Boolean  @default(false)                 // only one should be active at a time
  frequency    String   @default("session")             // every_visit | session | once_per_browser
  delaySeconds Int      @default(2) @map("delay_seconds")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("popups")
}
